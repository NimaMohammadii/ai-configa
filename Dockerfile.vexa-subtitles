FROM docker.io/friedrichrehren/yt-dlp:2026.08.19

USER root

# Keep all subtitle fonts in the image. libass resolves them through fontconfig,
# so rendering never installs packages or downloads font assets at request time.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends fontconfig fonts-dejavu-core fonts-noto-core fonts-noto-cjk fonts-quicksand fonts-vazirmatn; \
    fc-cache -f; \
    fc-match 'Quicksand' >/dev/null; \
    fc-match 'Vazirmatn' >/dev/null; \
    fc-match 'Noto Sans' >/dev/null; \
    fc-match 'Noto Sans Arabic' >/dev/null; \
    fc-match 'Noto Sans Devanagari' >/dev/null; \
    fc-match 'Noto Sans CJK SC' >/dev/null; \
    fc-match 'Noto Sans CJK JP' >/dev/null; \
    fc-match 'Noto Sans CJK KR' >/dev/null; \
    rm -rf /var/lib/apt/lists/*

USER 65532
WORKDIR /downloads
